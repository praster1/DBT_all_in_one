--- previous/models/l1/stg_events.sql
+++ current/models/l1/stg_events.sql
@@ -0,0 +1,6 @@
+with ranked as (
+ select *, row_number() over (partition by event_id order by ingestion_id desc) as delivery_rank
+ from {{ source('shop_raw', 'events') }}
+)
+select event_id, customer_id, event_time, substr(event_time,1,10) as event_date, event_type
+from ranked where delivery_rank = 1
--- previous/models/l1/stg_subscriptions_current.sql
+++ current/models/l1/stg_subscriptions_current.sql
@@ -0,0 +1,6 @@
+with ranked as (
+ select *, row_number() over (partition by subscription_id order by source_seq desc, ingestion_id desc) as version_rank
+ from {{ source('shop_raw', 'subscriptions') }}
+)
+select subscription_id, customer_id, status, monthly_cents
+from ranked where version_rank = 1
--- previous/models/l3/dim_customers.sql
+++ current/models/l3/dim_customers.sql
@@ -0,0 +1 @@
+select * from {{ ref('stg_customers_current') }}
--- previous/models/l3/mart_current_mrr.sql
+++ current/models/l3/mart_current_mrr.sql
@@ -0,0 +1,3 @@
+-- 단일 통화·월간 요금만 있는 실습. MRR은 주문 매출과 합산하지 않는다.
+select sum(case when status = 'active' then monthly_cents else 0 end) as mrr_cents
+from {{ ref('stg_subscriptions_current') }}
--- previous/models/l3/mart_customer_value.sql
+++ current/models/l3/mart_customer_value.sql
@@ -0,0 +1,2 @@
+select customer_id, count(*) as order_count, sum(recognized_cents) as recognized_cents
+from {{ ref('fct_orders') }} group by customer_id
--- previous/models/l3/mart_daily_active_users.sql
+++ current/models/l3/mart_daily_active_users.sql
@@ -0,0 +1,2 @@
+select event_date, count(distinct customer_id) as active_users
+from {{ ref('stg_events') }} group by event_date
--- previous/models/l3/mart_quality_summary.sql
